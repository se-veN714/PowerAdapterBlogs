PROJECT_PROFILE=product

# Optional build mirrors. Keep the official defaults outside mainland China.
DEBIAN_MIRROR_HOST=deb.debian.org
PIP_INDEX_URL=https://pypi.org/simple

# Django / public origin
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=example.com,admin.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://admin.example.com
DJANGO_TRUST_X_FORWARDED_PROTO=true
PUBLIC_SITE_URL=https://example.com
DEFAULT_FROM_EMAIL=PowerAdapter <webmaster@example.com>
SECURITY_CONTACT_EMAIL=security@example.com

# SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_TIMEOUT=10
# Comma-separated IPv4 endpoints. TLS still validates EMAIL_HOST.
EMAIL_SMTP_IPV4_FALLBACKS=

# PostgreSQL
DB_NAME=poweradapter
DB_USER=poweradapter
DB_PASSWORD=replace-with-a-long-random-password
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_CACHE_URL=redis://:replace-with-a-long-random-password@redis:6379/1
REDIS_SESSIONS_URL=redis://:replace-with-a-long-random-password@redis:6379/2

# MongoDB transaction-capable audit store
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-separate-root-password
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB_NAME=poweradapter_audit
MONGO_AUTH_SOURCE=poweradapter_audit
MONGO_REPLICA_SET=rs0
MONGO_DELIVERY_USERNAME=poweradapter_audit_delivery
MONGO_DELIVERY_PASSWORD=replace-with-a-delivery-password
MONGO_VERIFIER_USERNAME=poweradapter_audit_verifier
MONGO_VERIFIER_PASSWORD=replace-with-a-verifier-password
MONGO_DEPLOY_USERNAME=poweradapter_audit_deploy
MONGO_DEPLOY_PASSWORD=replace-with-a-deploy-password

# Generate each value independently; every decoded HMAC key must be 32 bytes.
LOGINTEGRITY_HMAC_KEY_BASE64=replace-me
MONGO_AUDIT_HMAC_KEY_BASE64=replace-me
CHECKPOINT_AUDIT_HMAC_KEY_BASE64=replace-me
MONGO_AUDIT_ACTIVE_KEY_ID=mongo-v1
CHECKPOINT_AUDIT_ACTIVE_KEY_ID=checkpoint-v1

# Privileged surfaces. Keep the public vhost unable to proxy /super_admin/.
MFA_ENFORCEMENT_ENABLED=true
MFA_ENROLLMENT_MODE_ENABLED=false
# URL-safe Base64 value must decode to 32 random bytes. Preserve old entries
# during key rotation until every stored TOTP seed has been re-encrypted.
MFA_TOTP_ACTIVE_KEY_ID=totp-v1
MFA_TOTP_KEYRING_JSON={"totp-v1":"replace-with-urlsafe-base64-32-byte-key"}
MTLS_ENFORCEMENT_ENABLED=true
MTLS_ADMIN_HOST=admin.example.com
MTLS_TRUSTED_PROXY_NETWORKS=172.16.0.0/12
MTLS_PROXY_AUTH_SECRET=replace-with-at-least-32-random-characters
MTLS_CERTIFICATE_PROFILE=standard-tls
SUPER_ADMIN_EXTERNAL_URL=https://admin.example.com/super_admin/

# AMap browser key and server-side JS security code.
AMAP_JS_API_ENABLED=true
AMAP_JS_API_KEY=replace-me
AMAP_JS_SECURITY_JSCODE=replace-me
AMAP_JS_SERVICE_HOST=/_AMapService

GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=120
WORKER_INTERVAL_SECONDS=5
AUDIT_WORKER_BATCH_SIZE=100
SKATE_WORKER_BATCH_SIZE=10
BOOTSTRAP_FRESH_SITE=false
BOOTSTRAP_OWNER_USERNAME=replace-with-existing-superuser-username
IMPORT_MUSIC_RECORDS=true
