# =============================================================================
# SK8 媒体分发（S4）——仅公开派生目录的 location 片段
# =============================================================================
# 引入方式：在对外 server{} 中 `include /etc/nginx/locations/skate_media.conf;`
# 并把 alias 路径改为部署实际值（= settings.SKATE_CLIP_DELIVERY_ROOT）。
# 参考 deploy/nginx/super_admin_mtls.conf.example 的组织方式。
#
# 安全边界（SKATEBOARD_GUIDE §5 / §9）：
#   1. 私有原片目录（media-private/skateboard/source）绝不出现在任何 location；
#      Django 侧 Storage.url() 亦直接抛错，两面封死。
#   2. /media/skate/tmp/ 是 Worker 临时输出（编码半成品），必须拒绝公开。
#   3. 派生文件名含 UUID；重处理为 os.replace 原子替换，同 URL 内容可能变化，
#      因此不用 immutable，用 1h 保守缓存 + Last-Modified/ETag 协商。
#
# 验收要点（SKATEBOARD_GUIDE §9 S4）：
#   - Content-Type：main/preview => video/webm，poster => image/webp。
#   - Range：curl -r 0-1023 应返回 206（nginx 静态文件原生支持，
#     sendfile on 且无 proxy 缓存截断即可）。
#   - 缓存头：Cache-Control: public, max-age=3600。
#   - 列目录：GET /media/skate/ 与 /media/skate/delivery/ 均应 403。
#   - tmp：GET /media/skate/tmp/<key>/1/main.webm 应 404。
# =============================================================================

location ^~ /media/skate/ {
    alias /srv/poweradapter/media/skate/;   # TODO 部署时改为实际派生根目录

    autoindex off;

    # Worker 临时输出不可公开（半成品可能缺少完整容器头）
    location ^~ /media/skate/tmp/ {
        return 404;
    }

    # 隐藏文件一律拒绝
    location ~ /\. {
        deny all;
    }

    # 只读分发（POST/PUT/DELETE 等一律 403）
    limit_except GET HEAD {
        deny all;
    }

    # 显式声明派生 MIME，防止自定义 mime.types 缺项
    # （nginx >= 1.11.5 默认已含 video/webm 与 image/webp）
    types {
        video/webm webm;
        image/webp webp;
    }

    add_header Cache-Control "public, max-age=3600" always;
    add_header Accept-Ranges bytes always;
}
